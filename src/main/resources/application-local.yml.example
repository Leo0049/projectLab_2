# 複製本檔為 application-local.yml 後填入自己的值，並以 SPRING_PROFILES_ACTIVE=local 啟動。
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# application-local.yml 已列入 .gitignore，不會被 git 追蹤。
# 如果你偏好用環境變數（.env）而不是這個檔案，可以完全略過本檔 —— application.yml
# 的預設值已經對應 docker-compose.yml，直接啟動即可。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/joindrink?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Taipei&allowPublicKeyRetrieval=true&useSSL=false
    username: joindrink
    password: joindrink

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

  data:
    redis:
      host: localhost
      port: 6379
      # 本機 docker Redis 未設密碼，留空即可
      password: ""

# 本機以 mock 模式跳過 Firebase 手機驗證，就不需要 serviceAccountKey.json
sms:
  mode: mock

firebase:
  config-path: classpath:serviceAccountKey.json

jwt:
  secret: LocalDevOnlySecretForJoinDrinkDoNotUseInProductionMustBeAtLeast64Chars!

# 填入你自己的 Cloudinary 憑證；留空則停用圖片上傳，不影響其他功能。
cloudinary:
  cloud-name: ""
  api-key: ""
  api-secret: ""

coupon:
  template-url: ""

app:
  # 本機演示用的模擬儲值；正式環境不可開啟。
  wallet:
    mock-top-up:
      enabled: true

  # 本機前端的來源白名單。application.yml 的預設列出 localhost／127.0.0.1 的 5500（靜態伺服器）與 8082（本機後端），另有 localhost:5173。
  # 若你用 VS Code Live Server 或 IDE 內建的伺服器，把它的來源加進下面這一行。
  # ⚠️ Live Server 的 5500 被占用時會靜默改用 5501，此時整個前端會因為 CORS 全部 403，
  #    請改用固定埠（或先釋放 5500）。直接以 file:// 開頁面不受支援。
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5502,http://localhost:5502,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:60687,http://localhost:54376,http://localhost:63342,http://localhost:8082,http://127.0.0.1:8082}
