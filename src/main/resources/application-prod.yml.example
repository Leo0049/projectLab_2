# ─────────────────────────────────────────────────────────────
# 正式環境 profile 範本。
# 用法：複製為 src/main/resources/application-prod.yml（已被 .gitignore 排除），
#       並以 SPRING_PROFILES_ACTIVE=prod 啟動。
#
# ⚠️ 此檔只放「非敏感」的正式值；所有密鑰一律走環境變數。
# ⚠️ OS 環境變數優先序高於本檔——請勿同時在環境設 JPA_SHOW_SQL=true。
# ─────────────────────────────────────────────────────────────
spring:
  jpa:
    show-sql: false           # 正式環境不在 stdout 刷 SQL
    hibernate:
      ddl-auto: validate      # schema 異動走人工 migration，啟動只驗證
    open-in-view: false

logging:
  level:
    root: INFO
    org.hibernate.SQL: WARN
    org.springframework.data.redis: WARN

# ⚠️ 手機驗證：prod profile 下必須是 firebase。
#    mock 模式會把 MOCK_TOKEN 當成已驗證的手機，任何人都能重設他人密碼。
#    AuthService 在啟動時就會檢查此值（不符即拒絕啟動），這裡寫上只是明確表達意圖。
sms:
  mode: firebase

app:
  security:
    csp:
      # 預設關閉（見 SecurityHeadersFilter 的說明）。
      # 要在正式環境開啟前，必須先把前端改成不依賴 inline script、
      # 並實際點過一輪主要流程（地圖、點餐、揪團、社群登入、WebSocket）。
      enabled: false
  demo-data:
    enabled: false            # 雙保險：即使忘了設 DEMO_DATA_ENABLED 也不植入示範帳號
  wallet:
    mock-top-up:
      enabled: false           # 正式環境不可用未付款請求增加錢包餘額
