# 複製為 .env 後填入自己的值：cp .env.example .env
# .env 已列入 .gitignore。docker compose 會自動讀取本檔同名的 .env。
#
# 注意：application.yml 內每個值都已內建「對應 docker-compose 的本機預設值」，
#       所以純本機開發其實不設定 .env 也能跑，只有 Cloudinary 需要自己填。

# ===== 本機 MySQL（docker-compose.yml）=====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=joindrink
DB_USERNAME=joindrink
DB_PASSWORD=joindrink
# 僅 docker-compose 建立容器時使用
MYSQL_ROOT_PASSWORD=root

# Hibernate DDL 模式：update（本機建表）/ validate（正式）/ none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ===== 本機 Redis（docker-compose.yml）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# 本機 docker Redis 未設密碼，留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== JWT =====
# HS512 需至少 64 字元。正式環境務必換掉，勿沿用預設值。
JWT_SECRET=your_super_long_random_jwt_secret_at_least_64_characters_long_change_me
JWT_EXPIRATION=86400000

# ===== Firebase =====
# 支援 classpath: 與 file: 前綴。本機若用 SMS_MODE=mock 可不必準備金鑰。
FIREBASE_CONFIG_PATH=classpath:serviceAccountKey.json

# ===== SMS / 手機驗證 =====
# mock：跳過 Firebase 驗證（本機開發用）｜ firebase：實際驗證
SMS_MODE=mock

# ===== Cloudinary =====
# ⚠️ 舊憑證已外洩，請先到 Cloudinary 後台 Rotate 之後再填入新的值。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== 優惠券模板圖片 =====
COUPON_TEMPLATE_URL=

# ===== 應用程式 =====
SERVER_PORT=8082
RESET_PASSWORD_URL=http://localhost:5173/Resetpassword
